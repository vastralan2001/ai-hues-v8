{
  "name": "aiushtha",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "check": "moon run :lint :format-check :typecheck",
    "dev:web": "moon run papers-web:dev",
    "dev:api": "moon run papers-api:dev",
    "dev": "moon run papers-web:dev papers-api:dev",
    "build": "moon run papers-web:build papers-api:build",
    "lint": "moon run :lint",
    "format": "moon run :format",
    "format:check": "moon run :format-check"
  },
  "devDependencies": {
    "@moonrepo/cli": "^1.41.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.4",
    "prettier": "^3.0.0",
    "simple-git-hooks": "^2.13.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm moon run :format-check :lint :typecheck --affected --status=staged"
  }
}
