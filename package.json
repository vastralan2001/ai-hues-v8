{
  "name": "aiushtha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare": "simple-git-hooks",
    "check": "moon run :lint :format :typecheck :test"
  },
  "devDependencies": {
    "@moonrepo/cli": "^1.41.5",
    "eslint": "^9.31.0",
    "eslint-plugin-workspaces": "^0.11.0",
    "git-conventional-commits": "^2.8.0",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "simple-git-hooks": "^2.13.0",
    "tsconfig-moon": "^1.4.1",
    "typescript-eslint": "^8.38.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm moon run :format-check :lint :typecheck --affected --status=staged",
    "commit-msg": "pnpm git-conventional-commits commit-msg-hook -c .commitlintrc.yaml \"$1\""
  },
  "type": "module",
  "engines": {
    "node": "^22.0.0 || ^24.0.0 || >=25.0.0",
    "pnpm": ">=10.18.3"
  },
  "packageManager": "pnpm@10.18.3",
  "pnpm": {
    "overrides": {
      "caniuse-lite": "latest"
    }
  }
}
