# AIHues Backend API (Go service)
AIHUES_API_BASE_URL=http://127.0.0.1:9005

# Google Analytics 4 (optional — enables event tracking)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Feishu wiki sync optional secret (enables auth guard in production)
FEISHU_SYNC_SECRET=your-random-secret

# LLM API Key — pick one provider:
# Kimi (Moonshot) — recommended for Chinese + English, fast setup
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxx
# Optional: override base URL and model (e.g. for proxy/Qianxun)
# KIMI_API_BASE_URL=https://openai.app.msh.team/v1/chat/completions
# KIMI_API_MODEL=gpt-4.1

# DeepSeek — good for Chinese content
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
# DEEPSEEK_API_BASE_URL=https://api.deepseek.com/v1/chat/completions
# DEEPSEEK_API_MODEL=deepseek-chat

# OpenAI — global standard
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_API_BASE_URL=https://api.openai.com/v1/chat/completions
# OPENAI_API_MODEL=gpt-3.5-turbo
